<?xml version="1.0" encoding="utf-8"?>
<image name="ubuntu-24.04-openstack">
    <description type="system">
        <author>Vipin Valsaraj</author>
        <contact>vipin@example.com</contact>
        <specification>Ubuntu 24.04 Golden Image</specification>
    </description>

    <preferences>
        <version>1.0.0</version>
        <packagemanager>apt</packagemanager>
        <type image="oem" 
              filesystem="ext4" 
              firmware="uefi" 
              format="qcow2"
              bootloader="grub2"
              initrd_system="dracut"
              kernelcmdline="console=ttyS0"
              efiparttable="gpt"
              fscreateoptions="-O ^metadata_csum_seed,^orphan_file">
            
            <oemconfig>
                <oem-resize>false</oem-resize>
            </oemconfig>
        </type>
    </preferences>

    <repository type="apt-deb" alias="ubuntu_main" distribution="noble" components="main universe restricted" repository_gpgcheck="false">
        <source path="http://in.archive.ubuntu.com/ubuntu/"/>
    </repository>

    <packages type="bootstrap">
        <package name="ca-certificates"/>
        <package name="apt"/>
        <package name="ubuntu-keyring"/>
    </packages>
<packages type="image">
    <package name="grub-pc-bin"/>
    <package name="grub-efi-amd64-bin"/>
    <package name="grub-common"/>
    
    <package name="grub-efi-amd64"/>
    <package name="shim-signed"/>
    
    <package name="linux-image-virtual"/>
    <package name="ubuntu-minimal"/>
    <package name="dracut"/>
    <package name="cloud-init"/>
    <package name="qemu-guest-agent"/>
    <package name="openssh-server"/>
</packages>

</image>
